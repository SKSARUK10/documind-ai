# ============================================================
# Node.js backend — environment variables (PLACEHOLDERS ONLY)
# ------------------------------------------------------------
# Copy to `.env` in this folder and fill in real values.
# Never commit `.env`.
# ============================================================

NODE_ENV=
PORT=

MONGODB_URI=

# FastAPI AI service base URL, e.g. http://localhost:8000
AI_SERVICE_URL=

# Comma-separated allowed CORS origins, e.g. http://localhost:5173
CORS_ORIGINS=

JWT_SECRET=

# Not used by this service directly, listed for completeness
LLM_API_KEY=
