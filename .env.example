# ============================================================
# DocuMind AI — root environment variables (PLACEHOLDERS ONLY)
# ------------------------------------------------------------
# These are EXAMPLES. Do NOT put real keys here.
# Copy this file to `.env` and fill in real values locally.
# `.env` is git-ignored and must never be committed.
# ============================================================

# --- General ---
NODE_ENV=
PORT=

# --- Database (Node.js backend) ---
MONGODB_URI=

# --- AI service ---
# URL the Node.js backend uses to reach the FastAPI service
AI_SERVICE_URL=

# --- LLM (paid API, provider not yet chosen) ---
LLM_API_KEY=

# --- Auth (Node.js backend) ---
JWT_SECRET=

# --- File storage (Cloudinary — considered in a later phase) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
