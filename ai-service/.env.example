# ============================================================
# FastAPI AI service — environment variables (PLACEHOLDERS ONLY)
# ------------------------------------------------------------
# Copy to `.env` in this folder and fill in real values.
# Never commit `.env`.
# ============================================================

# Uvicorn
HOST=
PORT=

# CORS origin of the frontend / backend that may call this service
ALLOWED_ORIGINS=

# --- LLM (paid API, provider chosen in Phase 4) ---
LLM_API_KEY=
LLM_MODEL=

# --- Embeddings (provider/model chosen in Phase 3) ---
EMBEDDING_MODEL=

# --- Storage ---
# Directory for uploaded PDFs and generated FAISS indexes
STORAGE_DIR=
